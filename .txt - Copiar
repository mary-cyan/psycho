        document.getElementById("dificultad").value = estadoXbox.dificultad;

        mostrarMensaje("Estado cargado correctamente.", 'success');

    } catch (error) {
        console.error("Error al cargar el estado:", error);
        mostrarMensaje("Error al cargar el estado. Verifica la consola.", 'error');
    }
}


